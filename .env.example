# Template only. Copy to .env and fill in real values. .env is gitignored.

# ---- Models: one line per role. Change a model here, nothing else to edit.
# Format <provider>:<model>, provider = openai | anthropic | bedrock | foundry | azure.
# A --model / --user-model flag overrides its line for a single run. The run
# manifest records the model actually used either way.

# The agent under test. support_agent is OpenAI-only; agent.tool_agent takes
# any provider, e.g. bedrock:anthropic.claude-opus-5 or anthropic:claude-opus-5.
AGENT_MODEL=openai:gpt-4o-mini
# Plays the customer in multi-turn cases (a case with user_sim and no script).
USER_MODEL=openai:gpt-4o-mini
# LLM_AS_JUDGE (answer quality). OpenAI model names. JUDGE_MODEL is the single
# judge; two-model rubrics add JUDGE_MODEL_2. The two must differ, and neither
# may be the agent's model - `ef run` refuses (exit 3) if one is, because a
# judge grading its own answers is biased. A different model family for
# JUDGE_MODEL_2 makes the second opinion more independent.
JUDGE_MODEL=gpt-5.6-terra
JUDGE_MODEL_2=gpt-4.1
# TypeSafe jev judge (tone).
JEV_MODEL=jev-latest

# ---- Credentials. Fill in only the providers your models above use.

# OpenAI - the agent, the simulated user and LLM_AS_JUDGE by default
OPENAI_API_KEY=sk-...

# TypeSafe jev judge. Calls api.typesafe.ai directly, no Cloudflare account id.
JEV=apikey_...

# Claude API
ANTHROPIC_API_KEY=

# Claude on Amazon Bedrock - region plus any normal AWS credential
# (AWS_PROFILE, access keys, or a Bedrock API key).
AWS_REGION=
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=

# Claude on Microsoft Foundry (Azure)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_BASE_URL=

# Azure OpenAI - for azure:<deployment> models, and for LLM_AS_JUDGE with
# LLM_JUDGE_PROVIDER=azure.
# LLM_JUDGE_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=
