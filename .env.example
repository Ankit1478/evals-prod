# Template only. Copy to .env and fill in real values. .env is gitignored.

# The agent under test
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Judges (Box 9) - deliberately different providers from the agent, so a
# judge cannot prefer its own family's answers. Both are optional: a judge
# with no credentials abstains, and an abstained score never gates.

# Judge 1 - TypeSafe jev, used for single yes/no semantic questions (tone).
# Calls api.typesafe.ai directly; no Cloudflare account id needed.
JEV=apikey_...

# Judge 2 - the vendored LLM_AS_JUDGE subsystem (vendor/llm_judge), used for
# answer quality on its own 4-criterion rubric. Uses OPENAI_API_KEY by default.
# Multi-judge pairs OPENAI_JUDGE_MODEL with OPENAI_MODEL; they must differ.
OPENAI_JUDGE_MODEL=gpt-5.6-terra

# Optional: run that judge on Azure instead (set LLM_JUDGE_PROVIDER=azure).
# LLM_JUDGE_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-a-secret
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional
# AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
# AZURE_OPENAI_TIMEOUT_SECONDS=30
# AZURE_OPENAI_MAX_RETRIES=2
# AZURE_OPENAI_MAX_OUTPUT_TOKENS=1200
